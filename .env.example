# Required: Alpaca Markets API keys
# Get yours at https://alpaca.markets (paper trading is free)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key

# Optional: sentiment and market data enrichment
# Finnhub (free tier at https://finnhub.io)
FINNHUB_API_KEY=your-finnhub-api-key

# Alpha Vantage (free tier at https://www.alphavantage.co)
ALPHA_VANTAGE_API_KEY=your-alphavantage-api-key

# Polygon.io (paid, needed for mcp_polygon_enabled in config)
# POLYGON_API_KEY=your-polygon-api-key
